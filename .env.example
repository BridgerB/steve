NOTIFY_TOKEN=your-token-here

# Shared Postgres for race logging (all bots write here; the eye-of-steve
# dashboard reads it). Copy this file to .env and fill in real credentials —
# .env is gitignored, never commit secrets.
DATABASE_URL="postgres://user:password@host:5432/steve"

# Remote Minecraft server the bots connect to. The bot brain runs locally
# (wherever you run launch-race.sh); only the world is remote.
MC_HOST=your.mc.server
MC_PORT=25565
MC_VERSION=1.21.11

# RCON is typically firewalled to localhost on the server. Reach it via an SSH
# tunnel and point MC_RCON_HOST at the local end:
#   ssh -N -L 25575:localhost:25575 user@your.mc.server
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASS=your-rcon-password

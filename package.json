{
	"name": "steve",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"sync-viewer": "node scripts/build-viewer.ts",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:apply:local": "wrangler d1 migrations apply steve --local",
		"db:apply:remote": "wrangler d1 migrations apply steve --remote"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@types/ws": "^8.18.1",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"esbuild": "^0.27.7",
		"playwright": "^1.60.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@babylonjs/core": "^9.0.0",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"echarts": "^6.1.0",
		"ws": "^8.19.0",
		"zod": "^4.3.6"
	}
}
